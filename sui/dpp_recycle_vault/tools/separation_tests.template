module dpp_recycle_vault::separation_tests;

use dpp_recycle_vault::separation::{Self, Registry, DppState};
use sui::clock::{Self, Clock};
use sui::test_scenario::{Self as ts, Scenario};

const ADMIN: address = @0xA;
const SUBMITTER: address = @0xD; // holds no capability; may submit anything
const RECIPIENT: address = @0xC;
const OTHER: address = @0xE;

const AMOUNT: u64 = 20_000_000;
const EXPIRES: u64 = 100_000;

const EVAL_PK: vector<u8> = x"@@EVAL_PK@@";
const ISSUER_PK: vector<u8> = x"@@ISSUER_PK@@";
const DPP_ID: vector<u8> = x"@@DPP_ID@@";
const MANDATE_ID: vector<u8> = x"@@MANDATE_ID@@";
const EVIDENCE: vector<u8> = x"@@EVIDENCE@@";
const OTHER_EVIDENCE: vector<u8> = x"@@OTHER_EVIDENCE@@";

const MANDATE_SIG_OK: vector<u8> = x"@@MANDATE_SIG_OK@@";
const ATTEST_SIG_OK: vector<u8> = x"@@ATTEST_SIG_OK@@";
const MANDATE_SIG_BY_EVALUATOR: vector<u8> = x"@@MANDATE_SIG_BY_EVALUATOR@@";
const ATTEST_SIG_BY_ISSUER: vector<u8> = x"@@ATTEST_SIG_BY_ISSUER@@";
const ATTEST_SIG_REJECTED: vector<u8> = x"@@ATTEST_SIG_REJECTED@@";

fun clock_at(s: &mut Scenario, ms: u64): Clock {
    let mut c = clock::create_for_testing(s.ctx());
    c.set_for_testing(ms);
    c
}

fun setup(): (Scenario, ID) {
    let mut s = ts::begin(ADMIN);
    separation::new_registry(EVAL_PK, ISSUER_PK, s.ctx());
    let pid = separation::new_dpp(DPP_ID, s.ctx());
    (s, pid)
}

fun run(
    s: &mut Scenario,
    pid: ID,
    recipient: address,
    amount: u64,
    evidence: vector<u8>,
    mandate_sig: vector<u8>,
    attestation_sig: vector<u8>,
    now_ms: u64,
) {
    run_v(s, pid, recipient, amount, evidence, 1, mandate_sig, attestation_sig, now_ms);
}

fun run_v(
    s: &mut Scenario,
    pid: ID,
    recipient: address,
    amount: u64,
    evidence: vector<u8>,
    verdict: u8,
    mandate_sig: vector<u8>,
    attestation_sig: vector<u8>,
    now_ms: u64,
) {
    run_ids(s, pid, MANDATE_ID, DPP_ID, recipient, amount, evidence, verdict,
        mandate_sig, attestation_sig, now_ms);
}

/// Same as run_v, but mandate id and dpp id can be chosen by the test.
fun run_ids(
    s: &mut Scenario,
    pid: ID,
    mandate_id: vector<u8>,
    dpp_id: vector<u8>,
    recipient: address,
    amount: u64,
    evidence: vector<u8>,
    verdict: u8,
    mandate_sig: vector<u8>,
    attestation_sig: vector<u8>,
    now_ms: u64,
) {
    s.next_tx(SUBMITTER);
    let mut reg = s.take_shared<Registry>();
    let mut dpp = s.take_shared_by_id<DppState>(pid);
    let c = clock_at(s, now_ms);
    separation::execute(
        &mut reg, &mut dpp, mandate_id, dpp_id, recipient, amount, EXPIRES,
        evidence, verdict, mandate_sig, attestation_sig, &c,
    );
    c.destroy_for_testing();
    ts::return_shared(reg);
    ts::return_shared(dpp);
}

/// A different 32-byte value (first byte inverted).
fun differs(v: vector<u8>): vector<u8> {
    let mut x = v;
    let b = *x.borrow(0);
    *x.borrow_mut(0) = b ^ 0xff;
    x
}

// 1. both signatures valid -> Recycled
#[test]
fun both_valid_signatures_execute() {
    let (mut s, pid) = setup();
    run(&mut s, pid, RECIPIENT, AMOUNT, EVIDENCE, MANDATE_SIG_OK, ATTEST_SIG_OK, 5_000);
    s.next_tx(ADMIN);
    let dpp = s.take_shared_by_id<DppState>(pid);
    assert!(separation::is_recycled(&dpp));
    ts::return_shared(dpp);
    s.end();
}

// 2. evaluator tries to write the constraints itself
