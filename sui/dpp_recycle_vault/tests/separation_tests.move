fun clock_at(s: &mut Scenario, ms: u64): Clock {
    let mut c = clock::create_for_testing(s.ctx());
    c.set_for_testing(ms);
    c
}

fun setup(): (Scenario, ID) {
    let mut s = ts::begin(ADMIN);
    separation::new_registry(EVAL_PK, ISSUER_PK, s.ctx());
    let pid = separation::new_dpp(DPP_ID, s.ctx());
    (s, pid)
}

fun run(
    s: &mut Scenario,
    pid: ID,
    recipient: address,
    amount: u64,
    evidence: vector<u8>,
    mandate_sig: vector<u8>,
    attestation_sig: vector<u8>,
    now_ms: u64,
) {
    run_v(s, pid, recipient, amount, evidence, 1, mandate_sig, attestation_sig, now_ms);
}

fun run_v(
    s: &mut Scenario,
    pid: ID,
    recipient: address,
    amount: u64,
    evidence: vector<u8>,
    verdict: u8,
    mandate_sig: vector<u8>,
    attestation_sig: vector<u8>,
    now_ms: u64,
) {
    s.next_tx(SUBMITTER);
    let mut reg = s.take_shared<Registry>();
    let mut dpp = s.take_shared_by_id<DppState>(pid);
    let c = clock_at(s, now_ms);
    separation::execute(
        &mut reg, &mut dpp, MANDATE_ID, DPP_ID, recipient, amount, EXPIRES,
        evidence, verdict, mandate_sig, attestation_sig, &c,
    );
    c.destroy_for_testing();
    ts::return_shared(reg);
    ts::return_shared(dpp);
}

// 1. both signatures valid -> Recycled
#[test]
fun both_valid_signatures_execute() {
    let (mut s, pid) = setup();
    run(&mut s, pid, RECIPIENT, AMOUNT, EVIDENCE, MANDATE_SIG_OK, ATTEST_SIG_OK, 5_000);
    s.next_tx(ADMIN);
    let dpp = s.take_shared_by_id<DppState>(pid);
    assert!(separation::is_recycled(&dpp));
    ts::return_shared(dpp);
    s.end();
}

